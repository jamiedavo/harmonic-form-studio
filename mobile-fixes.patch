+// Owns the per-frame time state so the 60fps loop only re-renders the SVG,
+// not the whole app (all the sliders/selects). Pauses when the tab is hidden
+// and honours prefers-reduced-motion. Runs at 30fps on touch devices.
+function AnimatedHarmonicSvg({ isPlaying, animSpeed, ...props }) {
+  const [timeOffset, setTimeOffset] = useState(0);
+
+
+  useEffect(() => {
+    if (!isPlaying) return undefined;
+    if (window.matchMedia?.("(prefers-reduced-motion: reduce)").matches) return undefined;
+
+    const minFrame = window.matchMedia?.("(pointer: coarse)").matches ? 1000 / 30 : 0;
+    let raf;
+    let last = performance.now();
+    const frame = (now) => {
+      raf = requestAnimationFrame(frame);
+      if (document.hidden || now - last < minFrame) return;
+      const dt = Math.min((now - last) / 1000, 0.1);
+      last = now;
+      setTimeOffset((prev) => (prev + dt * animSpeed * 1.5) % TAU);
+    };
+    raf = requestAnimationFrame(frame);
+    return () => cancelAnimationFrame(raf);
+  }, [isPlaying, animSpeed]);
+
+  return <HarmonicSvg {...props} timeOffset={timeOffset} />;
+}
+
 // ==========================================
 // REUSABLE UI CONTROLS
 // ==========================================
